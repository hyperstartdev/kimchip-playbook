# ===== Meta (Facebook/Instagram) Ads =====
# Meta 비즈니스 관리자 > 시스템 사용자 > 토큰 생성 (권한: ads_read)
META_ACCESS_TOKEN=
# 광고계정 ID (숫자만, act_ 제외)
META_AD_ACCOUNT_ID=
# (선택) Graph API 버전
META_API_VERSION=v21.0

# ===== Amazon Ads =====
# ※ Amazon Ads API 접근 승인 후 입력 가능
AMZN_CLIENT_ID=
AMZN_CLIENT_SECRET=
AMZN_REFRESH_TOKEN=
AMZN_PROFILE_ID=
# na(미국/북미) | eu | fe
AMZN_REGION=na
